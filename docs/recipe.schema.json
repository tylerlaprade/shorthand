{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorthand.local/recipe.schema.json",
  "title": "Shorthand Recipe",
  "type": "object",
  "required": ["name", "actions"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "unsupported": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "output_name": {
          "type": "string"
        }
      }
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/ref"
        }
      ]
    },
    "action": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "alert",
            "ask_for_input",
            "choose_from_menu",
            "comment",
            "current_date",
            "dictionary",
            "end_if",
            "end_menu",
            "end_repeat",
            "get_contents_of_url",
            "get_dictionary_from_input",
            "get_dictionary_value",
            "if",
            "menu_item",
            "notification",
            "open_url",
            "otherwise",
            "raw",
            "repeat_count",
            "repeat_each",
            "set_clipboard",
            "set_dictionary_value",
            "show_result",
            "text",
            "url"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}

